{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Static portfolio site for Ivan Mukoied.",
  "scripts": {
    "dev": "serve . -l 3000",
    "start": "serve . -l 3000",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint scripts",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "format": "prettier --write \"index.html\" \"styles/**/*.css\" \"scripts/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"index.html\" \"styles/**/*.css\" \"scripts/**/*.js\" \"*.{json,md}\"",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "postcss-selector-parser": "^7.1.1",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
